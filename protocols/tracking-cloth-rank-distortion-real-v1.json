    "expected_csv_recordings": 120,
    "dataset_state": "verified-complete-extracted",
    "raw_trajectory_publication_authorized": false
  },
  "query": {
    "name": "future cloth-centroid displacement",
    "dimension": 3,
    "units": "m",
    "definition": "mean marker position at t+h minus mean marker position at t"
  },
  "observation": {
    "name": "marker-wise constant-velocity displacement extrapolation",
    "units": "m",
    "definition": "(x_t-x_t-lag)*(dt_horizon/dt_lag)",
    "marker_counts": {
      "A2": 20,
      "A3": 12
    }
  },
  "split": {
    "unit": "recording",
    "assignment": "sha256(relative_path) round-robin after deterministic ordering",
    "training_only_model_fit": true,
    "heldout_recordings_never_used_for_covariance_or_subspace_fit": true
  },
  "methods": [
    "full",
    "optimal_generalized_eigen",
    "response_svd",
    "covariance_pca"
  ],
  "retained_ranks": [0, 1, 2, 3],
  "objective": {
    "name": "posterior-normalized covariance trace contraction",
    "formula": "trace(P_full^-1 (P_full-P_reduced))",
    "global_optimum_scope": "orthogonal projections of the fitted supplied factor U -> U V",
    "heldout_metrics": [
      "query_rmse_m",
      "mean_query_nll_nats",
      "mean_normalized_nees",
      "coverage_90",
      "posterior_validity",
      "heldout_normalized_mean_shift_risk"
    ]
  },
  "fold_count": 5,
  "lag_frames": 3,
  "horizon_frames": 6,
  "stride_frames": 6,
  "maximum_windows_per_recording": 2048,
  "minimum_recordings_per_size": 10,
  "joint_covariance_shrinkage": 0.15,
  "joint_covariance_ridge_fraction": 1e-05,
  "maximum_conditional_block_fraction": 0.2,
  "factor_eigenvalue_relative_tolerance": 1e-12,
  "rank_relative_tolerance": 1e-12,
  "optimality_relative_tolerance": 1e-08,
  "strict_improvement_relative_tolerance": 1e-08,
  "required_maximum_relative_parity_error": 1e-07,
  "claim_boundary": {
