+def create_material_identity_label_set(
+    collection: MaterialIdentityChoiceSetCollectionV1,
+    selections: Mapping[str, tuple[str, str]],
+    *,
+    label_definition: str,
+    group_definition: str,
+    metadata: Mapping[str, Any] | None = None,
+) -> MaterialIdentityLabelSetV1:
+    """Create a complete source/calibration label set from exact candidate IDs."""
+
+    if not isinstance(collection, MaterialIdentityChoiceSetCollectionV1):
+        raise TypeError("collection must be MaterialIdentityChoiceSetCollectionV1")
+    if not isinstance(selections, Mapping):
+        raise TypeError("selections must map choice-set IDs to (candidate ID, group ID)")
+    choice_sets = collection.by_id()
+    if set(selections) != set(choice_sets):
+        missing = sorted(set(choice_sets) - set(selections))
+        extra = sorted(set(selections) - set(choice_sets))
+        raise ValueError(f"selection coverage changed: missing={missing}, extra={extra}")
+    labels: list[MaterialIdentityChoiceLabelV1] = []
+    for choice_set_id, choice_set in choice_sets.items():
+        selection = selections[choice_set_id]
+        if type(selection) is not tuple or len(selection) != 2:
+            raise ValueError("every selection must be a (candidate_id, group_id) tuple")
+        candidate_id, group_id = selection
+        if candidate_id not in choice_set.candidate_ids:
+            raise ValueError("selected candidate does not belong to its choice set")
+        labels.append(
+            MaterialIdentityChoiceLabelV1(
+                choice_set_id=choice_set_id,
+                chosen_candidate_id=candidate_id,
+                group_id=group_id,
+            )
+        )
+    return MaterialIdentityLabelSetV1(
+        choice_set_collection_id=cast(str, collection.collection_id),
+        labels=tuple(labels),
+        label_definition=label_definition,
+